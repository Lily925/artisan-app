{
  "name": "artisan-server",
  "version": "1.0.0",
  "description": "Backend API for the Artisan marketplace (Express + MongoDB Atlas)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:demo": "node src/seed/demo.js",
    "test:api": "node tests/safety.test.mjs && node tests/register.test.mjs && node tests/password.test.mjs && node tests/shop-approval.test.mjs && node tests/notifications.test.mjs && node tests/chat.test.mjs && node tests/favorites.test.mjs",
    "test:notifications": "node tests/notifications.test.mjs",
    "test:chat": "node tests/chat.test.mjs",
    "test:favorites": "node tests/favorites.test.mjs",
    "test:password": "node tests/password.test.mjs",
    "test:shops": "node tests/shop-approval.test.mjs",
    "test:photos": "node tests/product-photos.test.mjs",
    "test:avatars": "node tests/avatars.test.mjs",
    "migrate:images": "node src/scripts/migrate-images-to-cloudinary.js",
    "migrate:shops": "node src/scripts/migrate-shop-status.js",
    "set-password": "node src/scripts/set-password.js",
    "test:safety": "node tests/safety.test.mjs",
    "test:all": "npm run test:api && npm run test:photos && npm run test:avatars"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^11.3.0",
    "nodemon": "^3.1.4"
  }
}
