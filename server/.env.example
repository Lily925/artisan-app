# Server settings. Copy to server/.env for local development; on Render, enter the same
# names under Environment. Placeholders only: never commit real values.
# With NODE_ENV=production the server refuses to start if a required variable is missing
# (see src/config/env.js and DEPLOY.md).

# "production" on the host. Leave unset locally.
# NODE_ENV=production

# Port to listen on. Render sets this itself; locally the default is 5000.
PORT=5000

# MongoDB Atlas connection string (required).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/artisan?retryWrites=true&w=majority

# Signs login tokens (required, at least 32 random characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# How long a login lasts (optional, default 7d).
JWT_EXPIRES_IN=7d

# The deployed frontend's origin, e.g. https://your-app.vercel.app (required in production;
# https, no path, no trailing slash, no wildcard). Several may be comma-separated. Browsers
# may call the API only from these; outside production http://localhost:3000 is also allowed.
CLIENT_URL=https://your-app.vercel.app

# PayPal REST app (developer.paypal.com → Apps & Credentials). Required in production.
# PAYPAL_MODE is "sandbox" or "live"; live keys only with "live".
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Photo storage (Cloudinary dashboard → Settings → API Keys). Required in production.
# Locally, leave all three unset to store photos on disk instead (development only).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Number of reverse-proxy hops in front of the server, so rate limits see the visitor's
# address. Default: 1 in production (Render), off locally.
# TRUST_PROXY=1

# Only if MongoDB fails with "querySrv ECONNREFUSED" on your network (Node can't use its DNS):
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Tests only (optional). The test scripts start a throwaway in-memory database by themselves.
# To use another one instead, name it here; its database name must contain "test" and must not
# be the one in MONGODB_URI. They refuse to run otherwise, and with NODE_ENV=production.
# MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/artisan_test?retryWrites=true&w=majority
