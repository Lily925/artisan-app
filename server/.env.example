PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/artisan?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# At least 32 random characters (the server won't start otherwise), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Browser origins allowed to call the API (comma-separated). Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind a reverse proxy / load balancer (makes rate limits per client)
# TRUST_PROXY=1
# NODE_ENV=production   (also turns on the HSTS header)
# Only if MongoDB fails with "querySrv ECONNREFUSED" on your network (Node can't use its DNS):
# DNS_SERVERS=8.8.8.8,1.1.1.1
# PayPal REST app credentials (developer.paypal.com → Apps & Credentials). Use sandbox keys
# for development; set PAYPAL_MODE=live only with live keys.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
# Photo storage (Cloudinary dashboard → Settings → API Keys). Set all three to store product
# and profile photos on Cloudinary. Leave all three unset to use local disk (development only;
# with NODE_ENV=production the server refuses to start without them).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
