# Frontend (Create React App) settings. Copy to .env and fill in.
# REACT_APP_* values are compiled into the public JS bundle: never put secrets here.

# API base URL. Default: http://localhost:5000/api
REACT_APP_API_URL=http://localhost:5000/api
# PayPal REST app *client id* (public). Must match PAYPAL_CLIENT_ID in server/.env.
REACT_APP_PAYPAL_CLIENT_ID=your-paypal-client-id
