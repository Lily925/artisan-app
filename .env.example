# Frontend (Create React App) settings. Copy to .env for local development; on Vercel, enter
# the same names under Settings → Environment Variables. They are read at BUILD time, so
# redeploy after changing them.
# REACT_APP_* values are compiled into the public JavaScript: never put secrets here.

# The API's base URL, ending in /api (required on Vercel; https there).
# Locally the default is http://localhost:5000/api.
REACT_APP_API_URL=https://your-api.onrender.com/api

# PayPal REST app *client id* (public). Must be the same app as PAYPAL_CLIENT_ID on the server.
REACT_APP_PAYPAL_CLIENT_ID=your-paypal-client-id

# The one-click demo logins on the login page appear only in development (npm start).
